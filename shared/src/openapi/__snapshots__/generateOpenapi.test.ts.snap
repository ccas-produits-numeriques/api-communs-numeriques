              "type": "object",
            },
            "type": "array",
          },
          "arrondissements": {
            "description": "Arrondissements de la commune",
            "items": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "description": "Code INSEE de l'arrondissement",
