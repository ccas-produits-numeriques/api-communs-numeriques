              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "page_index",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Numéro de la page actuelle (commence à 0)",
              "examples": [
                12,
