          "etablissement": {
            "additionalProperties": false,
            "description": "Etablissement de l'organisme",
            "properties": {
              "adresse": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Adresse",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Adresse de l'établissement",
              },
              "creation": {
                "description": "Date de création de l'établissement",
                "format": "date-time",
                "type": "string",
              },
              "enseigne": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Enseigne de l'établissement",
              },
              "fermeture": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Date de fermeture de l'établissement",
              },
              "geopoint": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/GeoJsonPoint",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Coordonnées GPS de l'établissement",
              },
              "ouvert": {
                "description": "Etablissement ouvert",
                "type": "boolean",
              },
              "siret": {
                "description": "Numéro SIRET de l'établissement",
                "pattern": "^\\d{14}$",
                "type": "string",
              },
            },
            "required": [
              "siret",
              "ouvert",
              "enseigne",
              "adresse",
              "geopoint",
              "creation",
              "fermeture",
            ],
            "type": "object",
          },
          "identifiant": {
            "additionalProperties": false,
            "description": "Identifiant de l'organisme",
            "properties": {
              "siret": {
                "description": "Numéro SIRET de l'organisme",
                "pattern": "^\\d{14}$",
                "type": "string",
              },
              "uai": {
                "anyOf": [
                  {
                    "pattern": "^\\d{7}[A-Z]$",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Numéro UAI de l'organisme",
              },
            },
            "required": [
              "uai",
              "siret",
            ],
            "type": "object",
          },
          "renseignements_specifiques": {
            "additionalProperties": false,
            "description": "Renseignements spécifiques",
            "properties": {
              "numero_activite": {
                "anyOf": [
                  {
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Numéro d'activité",
              },
              "qualiopi": {
                "description": "Qualiopi",
                "type": "boolean",
              },
            },
            "required": [
              "qualiopi",
              "numero_activite",
            ],
            "type": "object",
          },
          "statut": {
            "additionalProperties": false,
            "description": "Statut de l'organisme",
            "properties": {
              "referentiel": {
                "description": "Statut de l'organisme dans le réferentiel des organismes en apprentissage",
                "enum": [
                  "présent",
                  "supprimé",
                ],
                "type": "string",
              },
            },
            "required": [
              "referentiel",
            ],
            "type": "object",
          },
          "unite_legale": {
            "additionalProperties": false,
            "description": "Unité légale de l'organisme",
            "properties": {
              "actif": {
                "description": "Unité légale active",
                "type": "boolean",
              },
              "cessation": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Date de cessation de l'unité légale",
              },
              "creation": {
                "description": "Date de création de l'unité légale",
                "format": "date-time",
                "type": "string",
              },
              "raison_sociale": {
                "description": "Raison sociale de l'unité légale",
                "type": "string",
              },
              "siren": {
                "description": "Numéro SIREN de l'unité légale",
                "type": "string",
              },
            },
            "required": [
              "siren",
              "actif",
              "raison_sociale",
              "creation",
              "cessation",
            ],
            "type": "object",
          },
        },
        "required": [
          "identifiant",
          "etablissement",
          "unite_legale",
          "renseignements_specifiques",
          "statut",
          "contacts",
        ],
        "type": "object",
      },
      "Pagination": {
        "additionalProperties": false,
        "description": "Informations de pagination",
        "properties": {
          "page_count": {
            "description": "Nombre total de pages",
            "minimum": 0,
            "type": "integer",
          },
          "page_index": {
            "description": "Numéro de la page actuelle",
            "minimum": 0,
            "type": "integer",
          },
          "page_size": {
            "description": "Nombre d'éléments par page",
            "maximum": 1000,
            "minimum": 1,
            "type": "integer",
          },
        },
        "required": [
          "page_count",
          "page_size",
          "page_index",
        ],
        "type": "object",
      },
    },
    "securitySchemes": {
      "api-key": {
        "bearerFormat": "Bearer",
        "description": "Clé d'API à fournir dans le header \`Authorization\`. Si la route nécessite une habilitation particulière veuillez contacter le support pour en faire la demande à [api-communs-numeriques@courdecassation.fr](mailto:api-communs-numeriques@courdecassation.fr)",
        "scheme": "bearer",
        "type": "http",
      },
    },
  },
  "info": {
    "contact": {
      "email": "api-communs-numeriques@courdecassation.fr",
      "name": "Équipe API Communs numériques",
    },
    "license": {
      "name": "Etalab-2.0",
      "url": "https://github.com/etalab/licence-ouverte/blob/master/LO.md",
    },
    "termsOfService": "https://api.courdecassation.beta.gouv.fr/cgu",
    "title": "Documentation technique",
    "version": "V1.0",
  },
  "openapi": "3.1.0",
  "paths": {
    "/certification/v1": {
      "get": {
        "description": "Récupère la liste des certifications, filtrée par \`identifiant.cfd\` et \`identifiant.rncp\`",
        "operationId": "get_certification_v1",
        "parameters": [
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "identifiant.cfd",
            "required": false,
            "schema": {
              "description": "Filtre la liste des certifications par \`identifiant.cfd\`

- Si la valeur est vide ou \`null\`, filtre avec \`identifiant.cfd = null\`

- Si la valeur est absente, aucun filtre n'est appliqué

- Sinon doit respecter le regex \`/^[A-Z0-9]{3}\\d{3}[A-Z0-9]{2}$/\`",
              "examples": [
                "46X32402",
                "",
                "null",
              ],
              "pattern": "^([A-Z0-9]{3}\\d{3}[A-Z0-9]{2}|null)?$",
              "type": "string",
            },
          },
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "identifiant.rncp",
            "required": false,
            "schema": {
              "description": "Filtre la liste des certifications par \`identifiant.rncp\`

- Si la valeur est vide ou \`null\`, filtre avec \`identifiant.rncp = null\`

- Si la valeur est absente, aucun filtre n'est appliqué

- Sinon doit respecter le regex \`/^RNCP\\d{3,5}$/\`",
              "examples": [
                "RNCP12345",
                "",
                "null",
              ],
              "pattern": "^(RNCP\\d{3,5}|null)?$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Liste des communes correspondant au code INSEE ou postal recherché",
                  "items": {
                    "$ref": "#/components/schemas/Certification",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Succès",
          },
          "400": {
            "$ref": "#/components/responses/BadRequest",
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
          },
          "409": {
            "$ref": "#/components/responses/Conflict",
          },
          "419": {
            "$ref": "#/components/responses/TooManyRequests",
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError",
          },
          "502": {
            "$ref": "#/components/responses/BadGateway",
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable",
          },
        },
        "security": [
          {
            "api-key": [],
          },
        ],
        "summary": "Liste des certifications professionnelles",
        "tags": [
          "Certifications",
        ],
      },
    },
    "/formation/v1/appointment/generate-link": {
      "post": {
        "description": "Obtenir un lien d’accès à un formulaire de prise de rendez-vous auprès d’un centre de formation",
        "operationId": "generateFormationAppointmentLink",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "description": "Identifiant Parcoursup de la formation",
                    "properties": {
                      "parcoursup_id": {
                        "description": "Identifiant Parcoursup de la formation",
                        "type": "string",
                      },
                    },
                    "required": [
                      "parcoursup_id",
                    ],
                    "type": "object",
                  },
                  {
                    "additionalProperties": false,
                    "description": "Identifiant ONISEP de la formation",
                    "properties": {
                      "onisep_id": {
                        "description": "Identifiant ONISEP utilisé avec le mapping de la collection referentielonisep",
                        "type": "string",
                      },
                    },
                    "required": [
                      "onisep_id",
                    ],
                    "type": "object",
                  },
                  {
                    "additionalProperties": false,
                    "description": "Identifiant unique de la formation au sein du ministère de l'éducation",
                    "properties": {
                      "cle_ministere_educatif": {
                        "description": "Identifiant unique de la formation au sein du ministère de l'éducation",
                        "type": "string",
                      },
                    },
                    "required": [
                      "cle_ministere_educatif",
                    ],
                    "type": "object",
                  },
                ],
              },
            },
          },
          "description": "Identifiant de la formation, permettant de générer un lien de prise de rendez-vous pour la formation. Possibilité de fournir 1 paramètre parmi 3 types possibles : cle_ministere_educatif, parcoursup_id, onisep_id",
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "description": "Résultat en cas de succès",
                      "properties": {
                        "cfd": {
                          "description": "Code formation diplôme de la formation",
                          "type": "string",
                        },
                        "cle_ministere_educatif": {
                          "description": "Identifiant unique de la formation au sein du ministère de l'éducation",
                          "type": "string",
                        },
                        "code_postal": {
                          "description": "Code postal du lieu de formation",
                          "type": "string",
                        },
                        "etablissement_formateur_entreprise_raison_sociale": {
                          "description": "Raison social de l'établissement formateur",
                          "type": [
                            "string",
                            "null",
                          ],
                        },
                        "etablissement_formateur_siret": {
                          "description": "Le numéro de SIRET de l'établissement",
                          "examples": [
                            "78424186100011",
                          ],
                          "pattern": "^\\d{14}$",
                          "type": [
                            "string",
                            "null",
                          ],
                        },
                        "form_url": {
                          "description": "Lien de prise de rendez-vous Cour de cassation",
                          "type": "string",
                        },
                        "intitule_long": {
                          "description": "Intitulé long de la formation",
                          "type": "string",
                        },
                        "lieu_formation_adresse": {
                          "description": "Adresse du lieu de formation",
                          "type": "string",
                        },
                        "localite": {
                          "description": "Localité du lieu de formation",
                          "type": "string",
                        },
                      },
                      "required": [
                        "etablissement_formateur_entreprise_raison_sociale",
                        "intitule_long",
                        "lieu_formation_adresse",
                        "code_postal",
                        "etablissement_formateur_siret",
                        "cfd",
                        "localite",
                        "cle_ministere_educatif",
                        "form_url",
                      ],
                      "type": "object",
                    },
                    {
                      "description": "Résultat en cas d'erreur",
                      "properties": {
                        "error": {
                          "enum": [
                            "Appointment request not available",
                          ],
                          "type": "string",
                        },
                      },
                      "required": [
                        "error",
                      ],
                      "type": "object",
                    },
                  ],
                },
              },
            },
            "description": "Réponse",
          },
          "400": {
            "$ref": "#/components/responses/BadRequest",
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
          },
          "409": {
            "$ref": "#/components/responses/Conflict",
          },
          "419": {
            "$ref": "#/components/responses/TooManyRequests",
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError",
          },
          "502": {
            "$ref": "#/components/responses/BadGateway",
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable",
          },
        },
        "security": [
          {
            "api-key": [],
          },
        ],
        "summary": "Contacter un centre de formation via un lien dédié",
        "tags": [
          "Formation",
        ],
      },
    },
    "/formation/v1/search": {
      "get": {
        "description": "Accéder gratuitement à l’ensemble des formations disponibles en apprentissage",
        "operationId": "get_formation_v1_search",
        "parameters": [
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 100,
              "description": "Nombre d'éléments par page",
              "examples": [
                10,
              ],
              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "page_index",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Numéro de la page actuelle (commence à 0)",
              "examples": [
                12,
              ],
              "minimum": 0,
              "type": "integer",
            },
          },
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "latitude",
            "required": false,
            "schema": {
              "description": "Latitude de la coordonnée GPS de la zone de recherche.

La recherche couvrira l’ensemble de la France si elle n’est pas spécifiée.

Ce champ est obligatoire lorsqu’il est utilisé avec le champ de longitude.",
              "examples": [
                2.3522,
              ],
              "maximum": 90,
              "minimum": -90,
              "type": "number",
            },
          },
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "longitude",
            "required": false,
            "schema": {
              "description": "Longitude de la coordonnée GPS de la zone de recherche.

La recherche couvrira l’ensemble de la France si elle n’est pas spécifiée.

Ce champ est obligatoire lorsqu’il est utilisé avec le champ de latitude.",
              "examples": [
                48.8566,
              ],
              "maximum": 180,
              "minimum": -180,
              "type": "number",
            },
          },
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "radius",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Rayon de recherche en km, utile si une latitude et une longitude sont fournies. La valeur doit être comprise entre 0 et 200 et sera par défaut 30.",
              "examples": [
                30,
              ],
              "maximum": 200,
              "minimum": 0,
              "type": "number",
            },
          },
          {
            "in": "query",
            "name": "target_diploma_level",
            "required": false,
            "schema": {
              "description": "Niveau de diplôme cible à la fin des études.

Lors du filtrage par niveau de diplôme, nous retournons les données :

- où le niveau de diplôme cible est inconnu / non précisé / indifférent
- **et** lorsque le niveau de diplôme cible correspond au niveau de diplôme demandé

En filtrant sur le « 4 », seules les données relatives à ce niveau de diplôme, ainsi que celles avec des niveaux inconnus ou non précisés, vous seront renvoyées.",
              "enum": [
                "1",
                "2",
                "3",
                "4",
                "5",
                "6",
                "7",
                "8",
              ],
              "examples": [
                "3",
                "4",
                "5",
                "6",
                "7",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "romes",
            "required": false,
            "schema": {
              "description": "Code(s) ROME pour le champ de recherche

Le ROME correspond à la référence opérationnelle pour les métiers et les emplois conçue par France Travail.

Liste des codes séparés par des virgules

Les codes doivent respecter les formats ROME",
              "examples": [
                "F1601,F1201,F1106",
                "M1806",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "rncp",
            "required": false,
            "schema": {
              "description": "Code RNCP du périmètre de recherche

Le RNCP correspond au Répertoire national des certifications professionnelles de [France Compétences](https://www.francecompetences.fr/reguler-le-marche/certification-professionnelle/)",
              "examples": [
                "RNCP34436",
                "RNCP183",
              ],
              "pattern": "^RNCP\\d{3,5}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "include_archived",
            "required": false,
            "schema": {
              "default": "false",
              "description": "Inclure les formations archivées dans les résultats",
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "description": "Liste des formations correspondant aux critères de recherche",
                      "items": {
                        "$ref": "#/components/schemas/Formation",
                      },
                      "type": "array",
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination",
                    },
                  },
                  "required": [
                    "data",
                    "pagination",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Succès",
          },
          "400": {
            "$ref": "#/components/responses/BadRequest",
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
          },
          "409": {
            "$ref": "#/components/responses/Conflict",
          },
          "419": {
            "$ref": "#/components/responses/TooManyRequests",
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError",
          },
          "502": {
            "$ref": "#/components/responses/BadGateway",
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable",
          },
        },
        "security": [
          {
            "api-key": [],
          },
        ],
        "summary": "Recherche de formations en apprentissage",
        "tags": [
          "Formation",
        ],
      },
    },
    "/formation/v1/{id}": {
      "get": {
        "description": "Accéder au détail d'une formation en apprentissage à partir de son identifiant",
        "operationId": "get_formation_v1__id",
        "parameters": [
          {
            "allowEmptyValue": true,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Identifiant unique de la formation - clé ME",
              "examples": [
                "049510P01118838776490001178615112600012-49099#L01",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Formation",
                },
              },
            },
            "description": "Succès",
          },
          "400": {
            "$ref": "#/components/responses/BadRequest",
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
          },
          "409": {
            "$ref": "#/components/responses/Conflict",
          },
          "419": {
            "$ref": "#/components/responses/TooManyRequests",
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError",
          },
          "502": {
            "$ref": "#/components/responses/BadGateway",
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable",
          },
        },
        "security": [
          {
            "api-key": [],
          },
        ],
        "summary": "Consulter le détail d'une formation",
        "tags": [
          "Formation",
        ],
      },
    },
    "/geographie/v1/commune/search": {
      "get": {
        "description": "Recherche de communes par code insee ou postal. La recherche par code INSEE, recherche également parmis les anciennes communes fusionnées (déléguées ou associées) et parmis les arrondissements municipaux. Attention, un meme code postal peut-etre associé à plusieurs communes et une commune peut avoir plusieurs code postaux.",
        "operationId": "get_geographie_v1_commune_search",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "description": "Code INSEE ou postal recherché",
              "examples": [
                "75056",
                "75000",
              ],
              "pattern": "^\\d{5}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Liste des communes correspondant au code INSEE ou postal recherché",
                  "items": {
                    "$ref": "#/components/schemas/Commune",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Succès",
          },
          "400": {
            "$ref": "#/components/responses/BadRequest",
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
          },
