      "Formation": {
        "additionalProperties": false,
        "description": "Training",
        "properties": {
          "certification": {
            "additionalProperties": false,
            "description": "Certification de la formation",
            "properties": {
              "connue": {
                "description": "Lorsque la certification est connue, alors la certification est disponible dans l'API certifications

Dans le cas contraire, la certification est construite à partir des informations issue du RNCP et du CFD indépendemment.",
                "type": "boolean",
              },
              "valeur": {
                "$ref": "#/components/schemas/Certification",
              },
            },
            "required": [
              "valeur",
              "connue",
            ],
            "type": "object",
          },
          "contact": {
            "additionalProperties": false,
            "description": "Coordonnées à utiliser pour contacter l'organisme",
            "properties": {
              "email": {
                "anyOf": [
                  {
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Email de contact de la formation",
              },
              "telephone": {
                "anyOf": [
                  {
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Téléphone de contact de la formation",
              },
            },
            "required": [
              "email",
              "telephone",
            ],
            "type": "object",
          },
          "contenu_educatif": {
            "additionalProperties": false,
            "description": "Contenu éducatif de la formation",
            "properties": {
              "contenu": {
                "description": "Contenu de la formation",
                "type": "string",
              },
              "objectif": {
                "description": "Objectif de la formation",
                "type": "string",
              },
            },
            "required": [
              "contenu",
              "objectif",
            ],
            "type": "object",
          },
          "formateur": {
            "additionalProperties": false,
            "description": "Formateur de la formation

L'organisme formateur a pour mission de dispenser la formation",
            "properties": {
              "connu": {
                "description": "Indique si le formateur est connu de l'API

L'organisme est connu lorsqu'il est présent dans [le référentiel des organismes de formation](https://referentiel.apprentissage.onisep.fr/organismes) ou s'il l'a été dans le passé.

Il peut s'agir d'un organisme qui n'est plus sur le référentiel des organismes de formation. Veuillez vérifier le statut de l'organisme.",
                "type": "boolean",
              },
              "organisme": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Organisme",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "L'organisme de formation",
              },
            },
            "required": [
              "organisme",
              "connu",
            ],
            "type": "object",
          },
          "identifiant": {
            "additionalProperties": false,
            "description": "Identifiant de la formation",
            "properties": {
              "cle_ministere_educatif": {
                "description": "Identifiant unique de la formation sur [le catalogue des formations en apprentissage](https://catalogue-apprentissage.intercariforef.org/recherche/formations)",
                "type": "string",
              },
            },
            "required": [
              "cle_ministere_educatif",
            ],
            "type": "object",
          },
          "lieu": {
            "additionalProperties": false,
            "description": "Lieu où la formation est dispensée",
            "properties": {
              "adresse": {
                "$ref": "#/components/schemas/Adresse",
              },
              "geolocalisation": {
                "$ref": "#/components/schemas/GeoJsonPoint",
              },
              "precision": {
                "anyOf": [
                  {
                    "type": "number",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Précision de la géolocalisation du lieu de formation en mètres.

Il s'agit de la distance entre le point géolocalisé et la locasation déduite de l'adresse",
              },
              "siret": {
                "anyOf": [
                  {
                    "pattern": "^\\d{14}$",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Numéro SIRET du lieu de formation",
              },
              "uai": {
                "anyOf": [
                  {
                    "pattern": "^\\d{7}[A-Z]$",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Numéro UAI du lieu de formation",
              },
            },
            "required": [
              "adresse",
              "geolocalisation",
              "precision",
              "siret",
              "uai",
            ],
            "type": "object",
          },
          "modalite": {
            "additionalProperties": false,
            "description": "Modalité de la formation",
            "properties": {
              "annee_cycle": {
                "anyOf": [
                  {
                    "type": "integer",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "- L'année de démarrage de la session de formation.",
              },
              "duree_indicative": {
                "description": "Durée indicative de la formation",
                "type": "number",
              },
              "entierement_a_distance": {
                "description": "Indique si la formation est entièrement à distance",
                "type": "boolean",
              },
              "mef_10": {
                "anyOf": [
                  {
                    "pattern": "^\\d{10}$",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Code MEF 10 de la formation",
              },
            },
            "required": [
              "entierement_a_distance",
              "duree_indicative",
              "annee_cycle",
              "mef_10",
            ],
            "type": "object",
          },
          "onisep": {
            "additionalProperties": false,
            "description": "Informations lié à la formation issues de l'ONISEP",
