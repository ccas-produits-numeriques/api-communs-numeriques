    "/job/v1/apply": {
      "post": {
        "description": "To streamline your users' journey, this API allows you to directly transmit your users' applications to recruiters without them having to leave your site.

For this, it only requires the transmission of the candidate's contact information and resume. A cover letter, addressed to the recruiter, can also be optionally submitted. The application is then sent to the recruiter via email.",
        "operationId": "jobApply",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobApplicationWrite",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "id": {
                      "description": "Identifiant de la candidature.",
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "$ref": "#/components/responses/BadRequest",
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
          },
          "409": {
            "$ref": "#/components/responses/Conflict",
          },
          "419": {
            "$ref": "#/components/responses/TooManyRequests",
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError",
          },
          "502": {
            "$ref": "#/components/responses/BadGateway",
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable",
          },
        },
        "security": [
          {
            "api-key": [
              "applications:write",
            ],
          },
        ],
        "summary": "Envoi d’une candidature à une opportunité d’emploi",
        "tags": [
          "Job",
        ],
      },
    },
