                  "null",
                ],
              },
              "url": {
                "description": "Redirect URL to the application form",
                "examples": [
                  "https://labonnealternance.courdecassation.beta.gouv.fr/recherche-apprentissage?display=list&page=fiche&type=matcha&itemId=664752a2ebe24062b758c641",
                ],
                "format": "uri",
                "type": "string",
              },
            },
            "required": [
              "phone",
              "url",
            ],
            "type": "object",
          },
          "identifier": {
            "description": "This element includes:

- the partner responsible for the job offer
- the unique identifier of the job offer within the "Cour de cassation" information system",
            "properties": {
              "id": {
                "description": "Identifiant unique du recruteur",
                "examples": [
                  "6687165396d52b5e01b409545",
                ],
                "type": "string",
              },
            },
            "required": [
              "id",
            ],
            "type": "object",
          },
          "workplace": {
            "description": "Workplace is described by :

- The name (brand name or, failing that, the company name) and the SIRET number of the company.
- The description of the employer and/or the department where the contract will be carried out.
- The company's workforce range, in terms of the number of employees.
- The company's website.",
            "properties": {
              "brand": {
                "description": "Brand name of the establishment",
                "examples": [
                  "Enseigne (todo)",
                ],
                "type": [
                  "string",
                  "null",
                ],
              },
              "description": {
                "description": "Description of the employer and/or the department where the contract will be carried out.",
                "examples": [
                  "Service du Premier ministre, placé sous l’autorité du ministre de la Transformation et de la Fonction publiques, la direction interministérielle du numérique (DINUM) a pour mission d’élaborer la stratégie numérique de l’État et de piloter sa mise en œuvre. Notre objectif : un État plus efficace, plus simple et plus souverain grâce au numérique.",
                ],
                "type": [
                  "string",
                  "null",
                ],
              },
              "domain": {
                "description": "Groups elements that describe the field to which the company's SIRET number is linked:

The French Classification of Activities (NAF). Produced by INSEE, its aim is to facilitate the organization of economic and social information.
The IDCC number of the collective agreement. Produced by the ministry responsible for labor (Dares and DGT) and the one responsible for agriculture.
The Competency Operator (OPCO) responsible for managing the funding of the contract.",
                "properties": {
                  "idcc": {
                    "description": "Collective agreement number associated with the SIRET number",
                    "examples": [
                      1979,
                    ],
                    "type": [
                      "number",
                      "null",
                    ],
                  },
                  "naf": {
                    "description": "NAF (sector of activity) associated with the SIRET number",
                    "properties": {
                      "code": {
                        "description": "NAF code (sector of activity) associated with the SIRET number",
                        "examples": [
                          "8411Z",
                        ],
                        "type": "string",
                      },
                      "label": {
                        "description": "Label of the NAF code (sector of activity) associated with the SIRET number",
                        "examples": [
                          "Administration publique générale",
                        ],
                        "type": [
                          "string",
                          "null",
                        ],
                      },
                    },
                    "required": [
                      "code",
                      "label",
                    ],
                    "type": [
                      "object",
                      "null",
                    ],
                  },
                  "opco": {
                    "description": "Competency Operator (OPCO) associated with the SIRET number",
                    "examples": [
                      "OPCO 2i",
                    ],
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                },
                "required": [
                  "idcc",
                  "opco",
                  "naf",
                ],
                "type": "object",
              },
              "legal_name": {
                "description": "Company legal name or school legal name if is_delegated = true",
                "type": [
                  "string",
                  "null",
                ],
              },
              "location": {
                "description": "Postal address and geolocation linked to the company's SIRET number",
                "properties": {
                  "address": {
                    "description": "Postal address of the job offer location or of the school if is_delegated = true.",
                    "examples": [
                      "20 AVENUE DE SEGUR 75007 PARIS",
                    ],
                    "type": "string",
                  },
                  "geopoint": {
                    "$ref": "#/components/schemas/GeoJsonPoint",
                  },
                },
                "required": [
                  "address",
                  "geopoint",
                ],
                "type": "object",
              },
              "name": {
                "description": "Name of the establishment (brand name or, failing that, legal name) or school legal name if is_delegated = true

In the case of publishing a job offer, it is possible to use a custom name; otherwise, it will take the value of the brand name, or failing that, the legal name.",
                "examples": [
                  "DIRECTION INTERMINISTERIELLE DU NUMERIQUE (DINUM)",
                ],
                "type": [
                  "string",
                  "null",
                ],
              },
              "siret": {
                "description": "SIRET of the contract execution location or of the school if is_delegated = true",
                "examples": [
                  "13002526500013",
                ],
                "pattern": "^\\d{14}$",
                "type": [
                  "string",
                  "null",
                ],
              },
              "size": {
                "description": "Company workforce range, in number of employees",
                "examples": [
                  "100-199",
                ],
                "type": [
                  "string",
                  "null",
                ],
              },
              "website": {
                "description": "Company website",
                "examples": [
                  "https://beta.gouv.fr/startups/",
                ],
                "format": "uri",
                "type": [
                  "string",
                  "null",
                ],
              },
            },
            "required": [
              "name",
              "description",
              "website",
              "siret",
              "location",
              "brand",
              "legal_name",
              "size",
              "domain",
            ],
            "type": "object",
          },
        },
        "required": [
          "identifier",
          "workplace",
          "apply",
        ],
        "type": "object",
      },
      "MissionLocale": {
        "additionalProperties": false,
        "description": "Mission Locale",
        "properties": {
          "code": {
            "description": "Code de la mission locale",
            "type": "string",
          },
          "contact": {
            "additionalProperties": false,
            "description": "Contact de la mission locale",
            "properties": {
              "email": {
                "anyOf": [
                  {
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Email de contact de la mission locale",
              },
              "siteWeb": {
                "anyOf": [
                  {
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Site web de la mission locale",
              },
              "telephone": {
                "anyOf": [
                  {
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Téléphone de contact de la mission locale",
              },
            },
            "required": [
              "email",
              "telephone",
              "siteWeb",
            ],
            "type": "object",
          },
          "id": {
            "description": "Identifiant de la Mission Locale",
            "type": "number",
          },
          "localisation": {
            "additionalProperties": false,
            "description": "Localisation de la mission locale",
            "properties": {
              "adresse": {
                "description": "Adresse de la Mission Locale",
                "type": "string",
              },
              "cp": {
                "description": "Code postal de la Mission Locale",
                "type": "string",
              },
              "geopoint": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/GeoJsonPoint",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Coordonnés GPS au format GeoJSON "Point"",
              },
              "ville": {
                "description": "Ville de la Mission Locale",
                "type": "string",
              },
            },
            "required": [
              "geopoint",
              "adresse",
              "cp",
              "ville",
            ],
            "type": "object",
          },
          "nom": {
            "description": "Nom de la mission locale",
            "type": "string",
          },
          "siret": {
            "description": "Numéro SIRET de la mission locale",
            "type": "string",
          },
        },
        "required": [
          "id",
          "code",
          "nom",
          "siret",
          "localisation",
          "contact",
        ],
        "type": "object",
      },
      "Organisme": {
        "additionalProperties": false,
        "properties": {
          "contacts": {
            "description": "Contacts de l'organisme",
            "items": {
              "additionalProperties": false,
              "properties": {
                "confirmation_referentiel": {
                  "description": "Indique si le contact a un statut "confirmé" sur le référentiel des organismes de formation",
                  "type": "boolean",
                },
                "email": {
                  "description": "Email du contact",
                  "format": "email",
                  "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                  "type": "string",
                },
                "sources": {
                  "description": "Sources du contact",
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              },
              "required": [
                "email",
                "sources",
                "confirmation_referentiel",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "etablissement": {
            "additionalProperties": false,
            "description": "Etablissement de l'organisme",
            "properties": {
              "adresse": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Adresse",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Adresse de l'établissement",
              },
              "creation": {
                "description": "Date de création de l'établissement",
                "format": "date-time",
                "type": "string",
              },
              "enseigne": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Enseigne de l'établissement",
              },
              "fermeture": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Date de fermeture de l'établissement",
              },
              "geopoint": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/GeoJsonPoint",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Coordonnées GPS de l'établissement",
              },
              "ouvert": {
                "description": "Etablissement ouvert",
                "type": "boolean",
              },
              "siret": {
                "description": "Numéro SIRET de l'établissement",
                "pattern": "^\\d{14}$",
                "type": "string",
              },
            },
            "required": [
              "siret",
              "ouvert",
              "enseigne",
              "adresse",
              "geopoint",
              "creation",
              "fermeture",
            ],
            "type": "object",
          },
          "identifiant": {
            "additionalProperties": false,
            "description": "Identifiant de l'organisme",
            "properties": {
              "siret": {
                "description": "Numéro SIRET de l'organisme",
                "pattern": "^\\d{14}$",
                "type": "string",
              },
              "uai": {
                "anyOf": [
                  {
                    "pattern": "^\\d{7}[A-Z]$",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Numéro UAI de l'organisme",
              },
            },
            "required": [
              "uai",
              "siret",
            ],
            "type": "object",
          },
          "renseignements_specifiques": {
            "additionalProperties": false,
            "description": "Renseignements spécifiques",
            "properties": {
              "numero_activite": {
                "anyOf": [
                  {
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Numéro d'activité",
              },
              "qualiopi": {
                "description": "Qualiopi",
                "type": "boolean",
              },
            },
            "required": [
              "qualiopi",
              "numero_activite",
            ],
            "type": "object",
          },
          "statut": {
            "additionalProperties": false,
            "description": "Statut de l'organisme",
            "properties": {
              "referentiel": {
                "description": "Statut de l'organisme dans le réferentiel des organismes en apprentissage",
                "enum": [
                  "présent",
                  "supprimé",
                ],
                "type": "string",
              },
            },
            "required": [
              "referentiel",
            ],
            "type": "object",
          },
          "unite_legale": {
            "additionalProperties": false,
            "description": "Unité légale de l'organisme",
            "properties": {
              "actif": {
                "description": "Unité légale active",
                "type": "boolean",
              },
              "cessation": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Date de cessation de l'unité légale",
              },
              "creation": {
                "description": "Date de création de l'unité légale",
                "format": "date-time",
                "type": "string",
              },
              "raison_sociale": {
                "description": "Raison sociale de l'unité légale",
                "type": "string",
              },
              "siren": {
                "description": "Numéro SIREN de l'unité légale",
                "type": "string",
              },
            },
            "required": [
              "siren",
              "actif",
              "raison_sociale",
              "creation",
              "cessation",
            ],
            "type": "object",
          },
        },
        "required": [
          "identifiant",
          "etablissement",
          "unite_legale",
          "renseignements_specifiques",
          "statut",
          "contacts",
        ],
        "type": "object",
      },
      "Pagination": {
        "additionalProperties": false,
        "description": "Pagination information",
        "properties": {
          "page_count": {
            "description": "Total number of pages",
            "minimum": 0,
            "type": "integer",
          },
          "page_index": {
            "description": "Current page number",
            "minimum": 0,
            "type": "integer",
          },
          "page_size": {
            "description": "Number of items per page",
            "maximum": 1000,
            "minimum": 1,
            "type": "integer",
          },
        },
        "required": [
          "page_count",
          "page_size",
          "page_index",
        ],
        "type": "object",
      },
    },
    "securitySchemes": {
      "api-key": {
        "bearerFormat": "Bearer",
        "description": "",
        "scheme": "bearer",
        "type": "http",
      },
    },
  },
  "info": {
    "contact": {
      "email": "api-communs-numeriques@courdecassation.fr",
      "name": "",
    },
    "license": {
      "name": "Etalab-2.0",
      "url": "https://github.com/etalab/licence-ouverte/blob/master/LO.md",
    },
    "termsOfService": "https://api.courdecassation.beta.gouv.fr/cgu",
    "title": "",
    "version": "V1.0",
  },
  "openapi": "3.1.0",
  "paths": {
    "/certification/v1": {
      "get": {
        "description": "Récupère la liste des certifications, filtrée par \`identifiant.cfd\` et \`identifiant.rncp\`",
        "operationId": "get_certification_v1",
        "parameters": [
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "identifiant.cfd",
            "required": false,
            "schema": {
              "description": "Filtre la liste des certifications par \`identifiant.cfd\`

- Si la valeur est vide ou \`null\`, filtre avec \`identifiant.cfd = null\`

- Si la valeur est absente, aucun filtre n'est appliqué

- Sinon doit respecter le regex \`/^[A-Z0-9]{3}\\d{3}[A-Z0-9]{2}$/\`",
              "examples": [
                "46X32402",
                "",
                "null",
              ],
              "pattern": "^([A-Z0-9]{3}\\d{3}[A-Z0-9]{2}|null)?$",
              "type": "string",
            },
          },
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "identifiant.rncp",
            "required": false,
            "schema": {
              "description": "Filtre la liste des certifications par \`identifiant.rncp\`

- Si la valeur est vide ou \`null\`, filtre avec \`identifiant.rncp = null\`

- Si la valeur est absente, aucun filtre n'est appliqué

- Sinon doit respecter le regex \`/^RNCP\\d{3,5}$/\`",
              "examples": [
                "RNCP12345",
                "",
                "null",
              ],
              "pattern": "^(RNCP\\d{3,5}|null)?$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Liste des communes correspondant au code INSEE ou postal recherché",
                  "items": {
                    "$ref": "#/components/schemas/Certification",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "$ref": "#/components/responses/BadRequest",
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
          },
          "409": {
            "$ref": "#/components/responses/Conflict",
          },
          "419": {
            "$ref": "#/components/responses/TooManyRequests",
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError",
          },
          "502": {
            "$ref": "#/components/responses/BadGateway",
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable",
          },
        },
        "security": [
          {
            "api-key": [],
          },
        ],
        "summary": "Liste des certifications professionnelles",
        "tags": [
          "Certifications",
        ],
      },
    },
    "/formation/v1/appointment/generate-link": {
      "post": {
        "description": "Generate links for appointment requests for training via the Cour de cassation service",
        "operationId": "generateFormationAppointmentLink",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "description": "Identifiant Parcoursup de la formation",
                    "properties": {
                      "parcoursup_id": {
                        "description": "Identifiant Parcoursup de la formation",
                        "type": "string",
                      },
                    },
                    "required": [
                      "parcoursup_id",
                    ],
                    "type": "object",
                  },
                  {
                    "additionalProperties": false,
                    "description": "Identifiant ONISEP de la formation",
                    "properties": {
                      "onisep_id": {
                        "description": "ONISEP identifier of the training",
                        "type": "string",
                      },
                    },
                    "required": [
                      "onisep_id",
                    ],
                    "type": "object",
                  },
                  {
                    "additionalProperties": false,
                    "description": "Identifiant unique de la formation au sein du ministère de l'éducation",
                    "properties": {
                      "cle_ministere_educatif": {
                        "description": "Identifiant unique de la formation au sein du ministère de l'éducation",
                        "type": "string",
                      },
                    },
                    "required": [
                      "cle_ministere_educatif",
                    ],
                    "type": "object",
                  },
                ],
              },
            },
          },
          "description": "Identifiant de la formation, permettant de générer un lien de prise de rendez-vous pour la formation. Possibilité de fournir 1 paramètre parmi 3 types possibles : cle_ministere_educatif, parcoursup_id, onisep_id",
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "description": "Résultat en cas de succès",
                      "properties": {
                        "cfd": {
                          "description": "Training course code",
                          "type": "string",
                        },
                        "cle_ministere_educatif": {
                          "description": "Unique identifier of the training within the Ministry of Education",
                          "type": "string",
                        },
                        "code_postal": {
                          "description": "Training location postal code",
                          "type": "string",
                        },
                        "etablissement_formateur_entreprise_raison_sociale": {
                          "description": "Training organism name",
                          "type": [
                            "string",
                            "null",
                          ],
                        },
                        "etablissement_formateur_siret": {
                          "description": "SIRET number of the training establishment",
                          "examples": [
                            "78424186100011",
                          ],
                          "pattern": "^\\d{14}$",
                          "type": [
                            "string",
                            "null",
                          ],
                        },
                        "form_url": {
                          "description": "Appointment request link Cour de cassation",
                          "type": "string",
                        },
                        "intitule_long": {
                          "description": "Long title of the training",
                          "type": "string",
                        },
                        "lieu_formation_adresse": {
                          "description": "Training location address",
                          "type": "string",
                        },
                        "localite": {
                          "description": "Training location locality",
                          "type": "string",
                        },
                      },
                      "required": [
                        "etablissement_formateur_entreprise_raison_sociale",
                        "intitule_long",
                        "lieu_formation_adresse",
                        "code_postal",
                        "etablissement_formateur_siret",
                        "cfd",
                        "localite",
                        "cle_ministere_educatif",
                        "form_url",
                      ],
                      "type": "object",
                    },
                    {
                      "description": "Résultat en cas d'erreur",
                      "properties": {
                        "error": {
                          "enum": [
                            "Appointment request not available",
                          ],
                          "type": "string",
                        },
                      },
                      "required": [
                        "error",
                      ],
                      "type": "object",
                    },
                  ],
                },
              },
            },
            "description": "Response",
          },
          "400": {
            "$ref": "#/components/responses/BadRequest",
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
          },
          "409": {
            "$ref": "#/components/responses/Conflict",
          },
          "419": {
            "$ref": "#/components/responses/TooManyRequests",
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError",
          },
          "502": {
            "$ref": "#/components/responses/BadGateway",
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable",
          },
        },
        "security": [
          {
            "api-key": [],
          },
        ],
        "summary": "Contact a training center via a dedicated link",
        "tags": [
          "Training",
        ],
      },
    },
    "/formation/v1/search": {
      "get": {
        "description": "Accéder gratuitement à l’ensemble des formations disponibles en apprentissage",
        "operationId": "get_formation_v1_search",
        "parameters": [
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 100,
              "description": "Nombre d'éléments par page",
              "examples": [
                10,
              ],
              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "page_index",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Numéro de la page actuelle (commence à 0)",
              "examples": [
                12,
              ],
              "minimum": 0,
              "type": "integer",
            },
          },
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "latitude",
            "required": false,
            "schema": {
              "description": "Latitude of the GPS coordinate of the search area.

The search will cover the entire France if not specified.

This field should be mandatory when used with the longitude field.",
              "examples": [
                2.3522,
              ],
              "maximum": 90,
              "minimum": -90,
              "type": "number",
            },
          },
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "longitude",
            "required": false,
            "schema": {
              "description": "Longitude of the GPS coordinate of the search area.

The search will cover the whole of France if not specified.

This field must be mandatory when used with the longitude field.",
              "examples": [
                48.8566,
              ],
              "maximum": 180,
              "minimum": -180,
              "type": "number",
            },
          },
          {
            "allowEmptyValue": true,
            "in": "query",
            "name": "radius",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Search radius in km, useful if a latitude and longitude are provided. The value must be between 0 and 200 and will default to 30.",
              "examples": [
                30,
              ],
              "maximum": 200,
              "minimum": 0,
              "type": "number",
            },
          },
          {
            "in": "query",
            "name": "target_diploma_level",
            "required": false,
            "schema": {
              "description": "Target diploma level at the end of studies.

When filtering by diploma level, we return data :

- where the target diploma level is unknown / not specified / indifferent
- **and** where the target diploma level matches the requested diploma level

By filtering on \`4\`, only data related to this diploma level, as well as those with unknown/unspecified levels, will be returned to you.",
              "enum": [
                "1",
                "2",
                "3",
                "4",
                "5",
                "6",
                "7",
                "8",
              ],
              "examples": [
                "3",
                "4",
                "5",
                "6",
                "7",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "romes",
            "required": false,
            "schema": {
              "description": "ROME code(s) for the research scope

The ROME corresponds to the Operational Reference for Trades and Jobs designed by France Travail.

List of codes separated by commas

The codes must adhere to the ROME formats",
              "examples": [
                "F1601,F1201,F1106",
                "M1806",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "rncp",
            "required": false,
            "schema": {
              "description": "RNCP code of the research scope

The RNCP corresponds to the National Directory of Professional Certifications by [France Compétences](https://www.francecompetences.fr/reguler-le-marche/certification-professionnelle/)",
              "examples": [
                "RNCP34436",
                "RNCP183",
              ],
              "pattern": "^RNCP\\d{3,5}$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "include_archived",
            "required": false,
            "schema": {
              "default": "false",
              "description": "Inclure les formations archivées dans les résultats",
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "description": "List of training courses matching the search criteria",
                      "items": {
                        "$ref": "#/components/schemas/Formation",
                      },
                      "type": "array",
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination",
                    },
                  },
                  "required": [
                    "data",
                    "pagination",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "$ref": "#/components/responses/BadRequest",
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
          },
          "409": {
            "$ref": "#/components/responses/Conflict",
          },
          "419": {
            "$ref": "#/components/responses/TooManyRequests",
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError",
          },
          "502": {
            "$ref": "#/components/responses/BadGateway",
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable",
          },
        },
        "security": [
          {
            "api-key": [],
          },
        ],
        "summary": "Search for training courses in apprenticeship",
        "tags": [
          "Training",
        ],
      },
    },
