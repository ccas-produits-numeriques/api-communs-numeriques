    "/organisme/v1/recherche": {
      "get": {
        "description": "Récupère la liste des organismes, filtrée par UAI et/ou SIRET fournis",
        "operationId": "get_organisme_v1_recherche",
        "parameters": [
          {
            "in": "query",
            "name": "uai",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{7}[A-Z]$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "UAI de l'organisme à rechercher",
            },
          },
          {
            "in": "query",
            "name": "siret",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{14}$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "SIRET de l'organisme à rechercher",
            },
          },
        ],
        "responses": {
          "200": {
