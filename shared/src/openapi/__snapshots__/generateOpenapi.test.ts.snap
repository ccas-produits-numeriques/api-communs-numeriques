                      },
                      "type": "array",
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination",
                    },
                  },
                  "required": [
                    "data",
                    "pagination",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "$ref": "#/components/responses/BadRequest",
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
          },
          "409": {
            "$ref": "#/components/responses/Conflict",
          },
          "419": {
            "$ref": "#/components/responses/TooManyRequests",
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError",
          },
          "502": {
            "$ref": "#/components/responses/BadGateway",
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable",
          },
        },
        "security": [
          {
            "api-key": [],
          },
        ],
        "summary": "Récupération des organismes de formation en apprentissage",
        "tags": [
          "Organisms",
        ],
      },
    },
    "/organisme/v1/recherche": {
      "get": {
        "description": "Récupère la liste des organismes, filtrée par UAI et/ou SIRET fournis",
        "operationId": "get_organisme_v1_recherche",
        "parameters": [
          {
            "in": "query",
            "name": "uai",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{7}[A-Z]$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "UAI de l'organisme à rechercher",
            },
          },
          {
            "in": "query",
            "name": "siret",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{14}$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "SIRET de l'organisme à rechercher",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "candidats": {
                      "description": "Liste des organismes candidats correspondant aux critères de recherche",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "correspondances": {
                            "additionalProperties": false,
                            "description": "Informations sur les correspondances avec les critères de recherche",
                            "properties": {
                              "siret": {
                                "anyOf": [
                                  {
                                    "additionalProperties": false,
                                    "properties": {
                                      "lui_meme": {
                                        "description": "Le SIRET de l'organisme correspond exactement à celui recherché",
                                        "type": "boolean",
                                      },
                                      "son_formateur": {
                                        "description": "Le SIRET d'un de ces formateurs correspond à celui recherché",
                                        "type": "boolean",
                                      },
                                      "son_responsable": {
                                        "description": "Le SIRET du responsable de l'organisme correspond à celui recherché",
                                        "type": "boolean",
                                      },
                                    },
                                    "required": [
                                      "son_formateur",
                                      "son_responsable",
                                      "lui_meme",
                                    ],
                                    "type": "object",
                                  },
                                  {
                                    "description": "Aucune recherche par SIRET n'a été effectuée",
                                    "type": "null",
                                  },
                                ],
                                "description": "Informations sur les correspondances SIRET",
                              },
                              "uai": {
                                "anyOf": [
                                  {
                                    "additionalProperties": false,
                                    "properties": {
                                      "lui_meme": {
                                        "description": "L'UAI de l'organisme correspond exactement à celui recherché",
                                        "type": "boolean",
                                      },
                                      "son_lieu": {
                                        "description": "L'UAI d'un de ces lieux correspond à celui recherché",
                                        "type": "boolean",
                                      },
                                    },
                                    "required": [
                                      "lui_meme",
                                      "son_lieu",
                                    ],
                                    "type": "object",
                                  },
                                  {
                                    "description": "Aucune recherche par UAI n'a été effectuée",
                                    "type": "null",
                                  },
                                ],
                                "description": "Informations sur les correspondances UAI",
                              },
                            },
                            "required": [
                              "uai",
                              "siret",
                            ],
                            "type": "object",
                          },
                          "organisme": {
                            "additionalProperties": false,
                            "description": "Référence de l'organisme",
                            "properties": {
                              "identifiant": {
                                "additionalProperties": false,
                                "description": "Identifiant de l'organisme",
                                "properties": {
                                  "siret": {
                                    "description": "Numéro SIRET de l'organisme",
                                    "pattern": "^\\d{14}$",
                                    "type": "string",
                                  },
                                  "uai": {
                                    "anyOf": [
                                      {
                                        "pattern": "^\\d{7}[A-Z]$",
                                        "type": "string",
                                      },
                                      {
                                        "type": "null",
                                      },
                                    ],
                                    "description": "Numéro UAI de l'organisme",
                                  },
                                },
                                "required": [
                                  "uai",
                                  "siret",
                                ],
                                "type": "object",
                              },
                            },
                            "required": [
                              "identifiant",
                            ],
                            "type": "object",
                          },
                          "status": {
                            "additionalProperties": false,
                            "description": "Statut référencementiel de l'organisme",
                            "properties": {
                              "declaration_catalogue": {
                                "description": "Indique si l'organisme est présent dans le "Catalogue des formations en apprentissage"",
                                "type": "boolean",
                              },
                              "ouvert": {
                                "description": "Indique si l'organisme est ouvert (état administratif actif)",
                                "type": "boolean",
                              },
                              "validation_uai": {
                                "description": "Indique si l'UAI de l'organisme est validée par le Référentiel des Organismes de Formation",
                                "type": "boolean",
                              },
                            },
                            "required": [
                              "ouvert",
                              "declaration_catalogue",
                              "validation_uai",
                            ],
                            "type": "object",
                          },
                        },
                        "required": [
                          "status",
                          "correspondances",
                          "organisme",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "metadata": {
                      "additionalProperties": false,
                      "description": "Métadonnées sur les critères de recherche effectuée",
                      "properties": {
                        "siret": {
                          "anyOf": [
                            {
                              "additionalProperties": false,
                              "properties": {
                                "status": {
                                  "enum": [
                                    "inconnu",
                                    "fermé",
                                    "ok",
                                  ],
                                  "type": "string",
                                },
                              },
                              "required": [
                                "status",
                              ],
                              "type": "object",
                            },
                            {
                              "type": "null",
                            },
                          ],
                          "description": "Metadata sur le SIRET de recherche",
                        },
                        "uai": {
                          "anyOf": [
                            {
                              "additionalProperties": false,
                              "properties": {
                                "status": {
                                  "enum": [
                                    "inconnu",
                                    "ok",
                                  ],
                                  "type": "string",
                                },
                              },
                              "required": [
                                "status",
                              ],
                              "type": "object",
                            },
                            {
                              "type": "null",
                            },
                          ],
                          "description": "Metadata sur l'UAI de recherche",
                        },
                      },
                      "required": [
                        "uai",
                        "siret",
                      ],
                      "type": "object",
                    },
                    "resultat": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "correspondances": {
                              "additionalProperties": false,
                              "description": "Informations sur les correspondances avec les critères de recherche",
                              "properties": {
                                "siret": {
                                  "anyOf": [
                                    {
                                      "additionalProperties": false,
                                      "properties": {
                                        "lui_meme": {
                                          "description": "Le SIRET de l'organisme correspond exactement à celui recherché",
                                          "type": "boolean",
                                        },
                                        "son_formateur": {
                                          "description": "Le SIRET d'un de ces formateurs correspond à celui recherché",
                                          "type": "boolean",
                                        },
                                        "son_responsable": {
                                          "description": "Le SIRET du responsable de l'organisme correspond à celui recherché",
                                          "type": "boolean",
                                        },
                                      },
                                      "required": [
                                        "son_formateur",
                                        "son_responsable",
                                        "lui_meme",
                                      ],
                                      "type": "object",
                                    },
                                    {
                                      "description": "Aucune recherche par SIRET n'a été effectuée",
                                      "type": "null",
                                    },
                                  ],
                                  "description": "Informations sur les correspondances SIRET",
                                },
                                "uai": {
                                  "anyOf": [
                                    {
                                      "additionalProperties": false,
                                      "properties": {
                                        "lui_meme": {
                                          "description": "L'UAI de l'organisme correspond exactement à celui recherché",
                                          "type": "boolean",
                                        },
                                        "son_lieu": {
                                          "description": "L'UAI d'un de ces lieux correspond à celui recherché",
                                          "type": "boolean",
                                        },
                                      },
                                      "required": [
                                        "lui_meme",
                                        "son_lieu",
                                      ],
                                      "type": "object",
                                    },
                                    {
                                      "description": "Aucune recherche par UAI n'a été effectuée",
                                      "type": "null",
                                    },
                                  ],
                                  "description": "Informations sur les correspondances UAI",
                                },
                              },
                              "required": [
                                "uai",
                                "siret",
                              ],
                              "type": "object",
                            },
                            "organisme": {
                              "additionalProperties": false,
                              "description": "Référence de l'organisme",
                              "properties": {
                                "identifiant": {
                                  "additionalProperties": false,
                                  "description": "Identifiant de l'organisme",
                                  "properties": {
                                    "siret": {
                                      "description": "Numéro SIRET de l'organisme",
                                      "pattern": "^\\d{14}$",
                                      "type": "string",
                                    },
                                    "uai": {
                                      "anyOf": [
                                        {
                                          "pattern": "^\\d{7}[A-Z]$",
                                          "type": "string",
                                        },
                                        {
                                          "type": "null",
                                        },
                                      ],
                                      "description": "Numéro UAI de l'organisme",
                                    },
                                  },
                                  "required": [
                                    "uai",
                                    "siret",
                                  ],
                                  "type": "object",
                                },
                              },
                              "required": [
                                "identifiant",
                              ],
                              "type": "object",
                            },
                            "status": {
                              "additionalProperties": false,
                              "description": "Statut référencementiel de l'organisme",
                              "properties": {
                                "declaration_catalogue": {
                                  "description": "Indique si l'organisme est présent dans le "Catalogue des formations en apprentissage"",
                                  "type": "boolean",
                                },
                                "ouvert": {
                                  "description": "Indique si l'organisme est ouvert (état administratif actif)",
                                  "type": "boolean",
                                },
                                "validation_uai": {
                                  "description": "Indique si l'UAI de l'organisme est validée par le Référentiel des Organismes de Formation",
                                  "type": "boolean",
                                },
                              },
                              "required": [
                                "ouvert",
                                "declaration_catalogue",
                                "validation_uai",
                              ],
                              "type": "object",
                            },
                          },
                          "required": [
                            "status",
                            "correspondances",
                            "organisme",
                          ],
                          "type": "object",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "Meilleur résultat correspondant aux critères de recherche. Peut être null si aucun résultat sastisfaisant n'est trouvé.",
                    },
                  },
                  "required": [
                    "metadata",
                    "resultat",
                    "candidats",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "$ref": "#/components/responses/BadRequest",
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
          },
          "404": {
            "$ref": "#/components/responses/NotFound",
          },
          "409": {
