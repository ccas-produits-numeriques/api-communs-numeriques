                        "type": [
                          "string",
                          "null",
                        ],
                      },
                    },
                    "required": [
                      "code",
                      "label",
                    ],
                    "type": [
                      "object",
                      "null",
                    ],
                  },
                  "opco": {
                    "description": "OPérateur de Compétences (OPCO) associé au SIRET",
                    "examples": [
                      "OPCO 2i",
                    ],
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                },
                "required": [
                  "idcc",
                  "opco",
                  "naf",
                ],
                "type": "object",
              },
              "legal_name": {
                "description": "Raison sociale de l'entreprise ou raison sociale du CFA si is_delegated = true",
                "type": [
                  "string",
                  "null",
                ],
              },
              "location": {
                "description": "Adresse postale et géolocalisation rattachées au numéro SIRET de l’entreprise",
                "properties": {
