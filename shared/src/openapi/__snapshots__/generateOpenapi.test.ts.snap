      "JobOfferExport": {
        "description": "Informations concernant l'export de toutes les offres.",
        "properties": {
          "lastUpdate": {
            "description": "Date de l'export",
            "examples": [
              "2025-06-26T08:28:05.000Z",
            ],
            "format": "date-time",
            "type": "string",
          },
          "url": {
            "description": "URL de l'export. le lien de téléchargement est valable pendant 2 minutes. 

Les offres sont au format JSON. La structure de données des offres est identique à la réponse de la [route de recherche](/fr/documentation-technique#tag/Offre-Emploi/operation/jobSearch)",
            "examples": [
              "https://s3.rbx.io.cloud.ovh.net/bucket/file.json?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Content-Sha256=UNSIGNED-PAYLOAD",
            ],
            "type": "string",
          },
        },
        "required": [
          "url",
          "lastUpdate",
        ],
        "type": "object",
      },
      "JobOfferPublishing": {
        "description": "Informations sur la publication de l'offre d'emploi",
        "properties": {
          "publishing": {
            "description": "Informations sur la publication de l'offre d'emploi",
            "properties": {
              "error": {
                "description": "Objet contenant l'erreur",
                "properties": {
                  "code": {
                    "description": "Code de l'erreur. Ce code ne changera pas.",
                    "examples": [
                      "CLOSED_COMPANY",
                      "DUPLICATE",
                      "STAGE",
                      "EXPIRED",
                      "CFA",
                      "ROME_BLACKLISTED",
                      "WRONG_DATA",
                      "NON_DIFFUSIBLE",
                    ],
                    "type": "string",
                  },
                  "label": {
                    "description": "Description de l'erreur",
                    "examples": [
                      "WILL_BE_PUBLISHED",
                      "PUBLISHED",
                      "WILL_NOT_BE_PUBLISHED",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "code",
                  "label",
                ],
                "type": "object",
              },
              "status": {
                "description": "Etat de la publication. Si la valeur vaut WILL_NOT_BE_PUBLISHED, l'offre ne sera pas publiée.",
                "enum": [
                  "WILL_BE_PUBLISHED",
                  "PUBLISHED",
                  "WILL_NOT_BE_PUBLISHED",
                ],
                "examples": [
                  "WILL_BE_PUBLISHED",
                  "PUBLISHED",
                  "WILL_NOT_BE_PUBLISHED",
                ],
                "type": "string",
              },
            },
            "required": [
              "status",
            ],
            "type": "object",
          },
        },
        "required": [
          "publishing",
        ],
        "type": "object",
      },
      "JobOfferRead": {
        "description": "Offre d'emploi",
        "properties": {
          "apply": {
            "description": "Cet élément regroupe les différents moyens de candidature proposés aux candidats.

- URL vers laquelle rediriger le candidat pour qu’il postule
- Numéro de téléphone de la personne chargée du recrutement
- Identifiant de l’opportunité d’emploi, utile pour référencer l’offre et pour l'utilisation du widget de candidature /postuler",
            "properties": {
              "phone": {
                "description": "Numéro de téléphone du recruteur ou du CFA si is_delegated = true

Seuls les numéros de téléphone européens sont autorisés. Il y a également une vérification sur la nature du numéro : seuls les téléphones mobiles et fixes sont autorisés.",
                "examples": [
                  "0199000000",
                ],
                "type": [
                  "string",
                  "null",
                ],
              },
              "recipient_id": {
                "description": "Identifiant à utiliser pour postuler à l'offre d'emploi via la route /v3/jobs/apply ou pour afficher le widget postuler. Si null, la candidature n'est pas disponible pour cette offre par la route apply_route ni par le widget /postuler.",
                "type": [
                  "string",
                  "null",
                ],
              },
              "url": {
                "description": "URL de redirection vers le formulaire de candidature",
                "examples": [
                  "https://labonnealternance.courdecassation.beta.gouv.fr/recherche-apprentissage?display=list&page=fiche&type=matcha&itemId=664752a2ebe24062b758c641",
                ],
                "format": "uri",
                "type": "string",
              },
            },
            "required": [
              "phone",
              "url",
            ],
            "type": "object",
          },
          "contract": {
            "description": "Un contrat est décrit par :

- Le type (apprentissage et/ou professionnalisation).
- La date de début.
- La durée.
- Le mode de travail (présentiel, télétravail ou hybride).",
            "properties": {
              "duration": {
                "description": "Durée du contrat en mois.",
                "examples": [
                  12,
                ],
                "minimum": 0,
                "type": [
                  "integer",
                  "null",
                ],
              },
              "remote": {
                "description": "Mode de travail (sur site, à distance ou hybride)",
                "enum": [
                  "onsite",
                  "remote",
                  "hybrid",
                ],
                "examples": [
                  "onsite",
                  "remote",
                  "hybrid",
                ],
                "type": [
                  "string",
                  "null",
                ],
              },
              "start": {
                "description": "Date de début du contrat.",
                "examples": [
                  "2024-09-23T10:00:00.000Z",
                ],
                "format": "date-time",
                "type": [
                  "string",
                  "null",
                ],
              },
              "type": {
                "description": "Type de contrat (apprentissage et/ou professionnalisation)",
                "items": {
                  "description": "Type de contrat (apprentissage et/ou professionnalisation)",
                  "enum": [
                    "Apprentissage",
                    "Professionnalisation",
                  ],
                  "examples": [
                    "Apprentissage",
                    "Professionnalisation",
                  ],
                  "type": "string",
                },
                "type": "array",
              },
            },
            "required": [
              "start",
              "duration",
              "type",
              "remote",
            ],
            "type": "object",
          },
          "identifier": {
            "description": "Cet élément regroupe :

- le partenaire à l'origine de l'offre d'emploi
- l'identifiant unique de l'offre d'emploi au sein du système d'information Cour de cassation",
            "properties": {
              "id": {
                "description": "Identifiant de l'offre d'emploi dans la base de données Cour de cassation.

Les offres France Travail ne sont pas stockées dans la base de données Cour de cassation mais sont récupérées à la volée. Elles n'ont pas d'identifiant dans la base de données.",
                "examples": [
                  "6687165396d52b5e01b409545",
                ],
                "type": [
                  "string",
                  "null",
                ],
              },
              "partner_job_id": {
                "description": "Identifiant de l'offre dans le système d'information du partenaire.",
                "examples": [
                  "b16a546a-e61f-4028-b5a3-1a7bbfaa4e3d",
                ],
                "type": "string",
              },
              "partner_label": {
                "description": "Partenaire à l'origine de l'offre d'emploi.

Dans le cas des offres collectées par Cour de cassation, le partner_label est : "offres_emploi_lba".<br />Dans le cas des entreprises identifiées comme ayant un fort potentiel d’embauche, le partner_label est : "recruteurs_lba".",
                "examples": [
                  "France Travail",
                  "offres_emploi_lba",
                ],
                "type": "string",
              },
            },
            "required": [
              "partner_job_id",
              "id",
              "partner_label",
            ],
            "type": "object",
          },
          "is_delegated": {
            "default": false,
            "description": "Indique si la gestion de l'offre est déléguée à un CFA partenaire. valeurs true | false",
            "examples": [
              true,
            ],
            "type": "boolean",
          },
          "offer": {
            "description": "Une offre d’emploi est décrite par :

- L’intitulé. Exemple : Développeur / Développeuse web.
- La description. Exemple : Conçoit, développe et met au point un projet d'application informatique, de la phase d'étude à son intégration, pour un client ou une entreprise selon des besoins fonctionnels et un cahier des charges. Peut conduire des projets de développement. Peut coordonner une équipe.
- Le niveau de diplôme visé. Exemple : BP, Bac, autres formations niveau (Bac)
- Les compétences ou qualités attendues pour le poste. Exemple : Faire preuve d'autonomie ; Faire preuve de créativité, d'inventivité ; Faire preuve de rigueur et de précision ; Travailler en équipe
- Les compétences ou qualités à acquérir durant la formation. Exemple : Recherche, Innovation (Analyser les indicateurs pertinents sur les tendances et les usages des clients ; Concevoir et développer une solution digitale ; Créer une documentation technique). Nouvelles technologies (Assembler des composants logiciels ; Concevoir une application web)
- Les conditions d’accès au métier. Exemple : Ce métier est accessible avec un diplôme de niveau Bac+2 (BTS, DUT) à Master (MIAGE, diplôme d'ingénieur, Master professionnel, ...) en informatique. Il est également accessible avec une expérience professionnelle en informatique, système d'exploitation ou dans un domaine applicatif. La pratique de l'anglais (vocabulaire technique) est requise.
- Le nombre de postes à pourvoir.
- Le ou les codes ROME associés. Exemple : M1805, M1806, M1807",
            "properties": {
              "access_conditions": {
                "description": "Les conditions d'accès au métier",
                "items": {
                  "description": "Les conditions d'accès au métier",
                  "examples": [
                    "Ce métier est accessible avec un diplôme de niveau Bac+2 (BTS, DUT) à Master (MIAGE, diplôme d'ingénieur, Master professionnel, ...) en informatique.",
                    "Il est également accessible avec une expérience professionnelle en informatique, système d'exploitation ou dans un domaine applicatif.",
                    "La pratique de l'anglais (vocabulaire technique) est requise.",
                  ],
                  "type": "string",
                },
                "type": "array",
              },
              "description": {
                "description": "Description de l'offre d'emploi.",
                "examples": [
                  "Conçoit, développe et met au point un projet d'application informatique, de la phase d'étude à son intégration, pour un client ou une entreprise selon des besoins fonctionnels et un cahier des charges. Peut conduire des projets de développement. Peut coordonner une équipe.",
                ],
                "type": "string",
              },
              "desired_skills": {
                "description": "Les compétences ou qualités attendues pour le poste.",
                "items": {
                  "description": "Les compétences ou qualités attendues pour le poste.",
                  "examples": [
                    "Faire preuve d'autonomie",
                    "Faire preuve de créativité, d'inventivité",
                    "Faire preuve de rigueur et de précision",
                    "Travailler en équipe",
                  ],
                  "type": "string",
                },
                "type": "array",
              },
              "opening_count": {
                "description": "Nombre de postes disponibles pour cette offre d'emploi",
                "examples": [
                  1,
                  3,
                ],
                "type": "number",
              },
              "publication": {
                "description": "Une opportunité d’emploi possède un cycle de vie : une date de création et une date d'expiration.",
                "properties": {
                  "creation": {
                    "description": "Date de création de l'opportunité d'emploi.",
                    "examples": [
                      "2024-07-23T13:23:01.000Z",
                    ],
                    "format": "date-time",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "expiration": {
                    "description": "Date d'expiration de l'opportunité d'emploi.",
                    "examples": [
                      "2027-05-14T00:00:00Z",
                    ],
                    "format": "date-time",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                },
                "required": [
                  "creation",
                  "expiration",
                ],
                "type": "object",
              },
              "rome_codes": {
                "description": "Code(s) ROME de l'offre",
                "items": {
                  "description": "Code ROME",
                  "examples": [
                    "A1401",
                  ],
                  "pattern": "^[A-Z]\\d{4}$",
                  "type": "string",
                },
                "type": "array",
              },
              "status": {
                "description": "Le statut de l'offre (cycle de vie) :

- Active : L'offre est disponible sur la plateforme et il est possible d'y postuler.
- Filled : L'offre a été pourvue et n'est donc plus disponible.
- Cancelled : L'offre a été annulée et n'est donc plus disponible.

Seules les offres actives sont retournées par la recherche.",
                "enum": [
                  "Active",
                  "Filled",
                  "Cancelled",
                ],
                "examples": [
                  "Active",
                ],
                "type": "string",
              },
              "target_diploma": {
                "description": "Diplôme visé à l'issue des études.",
                "properties": {
                  "european": {
                    "description": "Diplôme visé à l'issue des études.",
                    "enum": [
                      "3",
                      "4",
                      "5",
                      "6",
                      "7",
                    ],
                    "examples": [
                      "3",
                    ],
                    "type": "string",
                  },
                  "label": {
                    "description": "Le nom du diplôme visé à l'issue des études.",
                    "examples": [
                      "BP, Bac, autres formations niveau (Bac)",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "european",
                  "label",
                ],
                "type": [
