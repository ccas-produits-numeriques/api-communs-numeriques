{
  "name": "mna",
  "description": "[MNA] Template apprentissage",
  "version": "0.0.0",
  "author": "MNA",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@sentry/cli": "^2.52.0",
    "dotenv": "^17.2.1",
    "global": "4.4.0",
    "husky": "^9.1.7"
  },
  "scripts": {
    "setup": ".bin/mna-api env:init",
    "setup:mongodb": "docker compose exec -it mongodb mongosh --eval \"try { rs.status().ok } catch (e) { if (e.code === 94) {rs.initiate();} else {throw e} }\" --quiet",
    "dev": "pnpm services:start; pnpm foreach:parallel run dev",
    "cli": "pnpm --filter server cli",
    "seed": ".bin/mna-api seed:apply",
    "deploy": ".bin/mna-api app:deploy",
    "build": "pnpm foreach:seq run build",
    "migrations:status": "pnpm cli migrations:status",
    "migrations:up": "pnpm cli migrations:up",
    "migrations:create": "pnpm cli migrations:create",
    "server:dev": "pnpm --filter server dev",
    "ui:dev": "pnpm --filter ui dev",
    "services:start": "docker compose up --build --remove-orphans -d --wait",
    "services:stop": "docker compose down",
    "services:clean": "pnpm services:stop; docker system prune --volumes",
    "seed:update": ".bin/mna-api seed:update",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "prettier:fix": "prettier --write -u .",
    "prettier:check": "prettier --check -u .",
    "postinstall": "husky",
    "talisman:add-exception": "pnpm node-talisman --githook pre-commit -i",
    "test": "vitest",
    "test:ci": "pnpm test --run",
    "test:ci:coverage": "pnpm test:ci --coverage.include='ui' --coverage.include='server/src' --coverage.include='shared' --coverage.provider='v8' --coverage.enabled --coverage.all --coverage.exclude='**/tests' --coverage.exclude='**/.next'",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -b ui/tsconfig.json server/tsconfig.json shared/tsconfig.json sdk/tsconfig.json",
    "vault:edit": ".bin/mna-api vault:edit",
    "product:access:update": ".bin/mna-api product:access:update",
    "foreach:seq": "pnpm -r --workspace-concurrency=1",
    "foreach:parallel": "pnpm -r --parallel",
    "foreach:ci": "pnpm -r --workspace-concurrency=1"
  },
  "devDependencies": {
    "@dword-design/eslint-plugin-import-alias": "^6.0.3",
    "@eslint/compat": "^1.3.2",
    "@eslint/js": "^9.33.0",
    "@next/eslint-plugin-next": "^15.4.6",
    "@types/node": "^24.2.1",
    "commander": "^14.0.0",
    "eslint": "^9.33.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "lint-staged": "^16.1.5",
    "node-talisman": "^1.29.22",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "prettier": {
    "printWidth": 120,
    "bracketSpacing": true,
    "trailingComma": "es5",
    "arrowParens": "always"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --cache --fix",
      "prettier --write -u"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs})": [
      "prettier --write -u"
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "exceljs@4.4.0": "patches/exceljs@4.4.0.patch"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry-internal/node-cpu-profiler",
      "@sentry/cli",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@types/mjml-core": "4.15.2",
      "nock": "14.0.10",
      "react-dom": "19.2.3",
      "zod": "4.0.17"
    }
  }
}
