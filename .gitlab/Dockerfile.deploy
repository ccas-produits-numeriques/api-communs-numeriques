FROM node:24-bookworm-slim

ARG http_proxy
ARG https_proxy
ARG no_proxy
ENV http_proxy=$http_proxy \
    https_proxy=$https_proxy \
    HTTP_PROXY=$http_proxy \
    HTTPS_PROXY=$https_proxy \
    no_proxy=$no_proxy \
    NO_PROXY=$no_proxy \
    NODE_USE_ENV_PROXY=1

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    ansible \
    curl \
    jq \
    openssh-client \
    yq \
    git \
    gnupg \
    skopeo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# SOPS : requis par community.sops.load_vars (déploiement) et view-vault.sh (release)
ARG SOPS_VERSION=3.13.1
RUN curl -fsSL "https://github.com/getsops/sops/releases/download/v${SOPS_VERSION}/sops-v${SOPS_VERSION}.linux.amd64" -o /usr/local/bin/sops \
    && chmod +x /usr/local/bin/sops

RUN npm install -g pnpm@10.15.1

WORKDIR /app
